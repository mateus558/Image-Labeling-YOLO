# Byte-compiled / optimized / DLL files
__pycache__/
src/__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/
.env

# Installer logs
pip-log.txt

# Unit test / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# MyPy / static analysis
.mypy_cache/
.pyre/

# IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Logs and temporary files
*.log
tmp/
temp/
*.tmp

# Notebook checkpoints, outputs
.ipynb_checkpoints/

# Model weights / checkpoints (often large)
*.pth
*.pt
*.ckpt

# Project-specific generated outputs
outputs/
# Keep source labels but ignore copied/processed images (usually large)
yolo_dataset/images/
runs/

# GroundingDINO / cache-like files
.cache/

# Optional: ignore user-specific overrides
local_settings.py

# Keep labels directory tracked; adjust rules above if you want to ignore label files too
# (e.g. yolo_dataset/labels/)
seed_images/
